--synthesis_resources = 
SUBDESIGN meminit_p1v
( 
	clock	:	input;
	datain[7..0]	:	input;
	dataout[7..0]	:	output;
	init	:	input;
) 

BEGIN 
	ASSERT (0) 
	REPORT "MGL_INTERNAL_WARNING: ( The parameter value is not one of the pre-specified values in the value list.) altmem_init|PORT_ROM_DATA_READY The value assigned is PORT_CONNECTIVITY and the valid value list is PORT_UNUSED|PORT_USED"
	SEVERITY WARNING;
	ASSERT (0) 
	REPORT "The value entered for numwords (50) is incorrect based on the addressable range covered by the parameter widthad (0 to 32)"
	SEVERITY ERROR;
END;
--ERROR FILE
