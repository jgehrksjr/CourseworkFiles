initial 

begin 
$timeformat(-12,3," ps",6);
#10000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module CE4720_SimpleCPU_vlg_vec_tst();
// constants                                           
// general purpose registers
reg Clock;
reg Reset;
// wires                                               
wire [7:0] AC_OUT;
wire ACload;
wire [1:0] ALUSEL;
wire [7:0] AR_IN;
wire [4:0] AR_OUT;
wire ARload;
wire BUS_AC;
wire BUS_ALU;
wire BUS_DR;
wire BUS_MEM;
wire BUS_PC;
wire CPUclk;
wire [7:0] DR_OUT;
wire DRload;
wire [2:0] IR_OUT;
wire IRload;
wire [7:0] MainBus;
wire MDenable;
wire [7:0] MEM_OUT;
wire MemRead;
wire MemWrite;
wire [4:0] MuxOut;
wire [7:0] PC_OUT;
wire PCinc;
wire PCload;
wire PCloadAR;
wire PCloadZ;
wire Zflag;
wire Zload;

wire sampler;                             

// assign statements (if any)                          
CE4720_SimpleCPU i1 (
// port map - connection between master ports and signals/registers   
	.AC_OUT(AC_OUT),
	.ACload(ACload),
	.ALUSEL(ALUSEL),
	.AR_IN(AR_IN),
	.AR_OUT(AR_OUT),
	.ARload(ARload),
	.BUS_AC(BUS_AC),
	.BUS_ALU(BUS_ALU),
	.BUS_DR(BUS_DR),
	.BUS_MEM(BUS_MEM),
	.BUS_PC(BUS_PC),
	.Clock(Clock),
	.CPUclk(CPUclk),
	.DR_OUT(DR_OUT),
	.DRload(DRload),
	.IR_OUT(IR_OUT),
	.IRload(IRload),
	.MainBus(MainBus),
	.MDenable(MDenable),
	.MEM_OUT(MEM_OUT),
	.MemRead(MemRead),
	.MemWrite(MemWrite),
	.MuxOut(MuxOut),
	.PC_OUT(PC_OUT),
	.PCinc(PCinc),
	.PCload(PCload),
	.PCloadAR(PCloadAR),
	.PCloadZ(PCloadZ),
	.Reset(Reset),
	.Zflag(Zflag),
	.Zload(Zload)
);

// Clock
always
begin
	Clock = 1'b0;
	Clock = #10000 1'b1;
	#10000;
end 

// Reset
initial
begin
	Reset = 1'b1;
	Reset = #120000 1'b0;
end 

CE4720_SimpleCPU_vlg_sample_tst tb_sample (
	.Clock(Clock),
	.Reset(Reset),
	.sampler_tx(sampler)
);

CE4720_SimpleCPU_vlg_check_tst tb_out(
	.AC_OUT(AC_OUT),
	.ACload(ACload),
	.ALUSEL(ALUSEL),
	.AR_IN(AR_IN),
	.AR_OUT(AR_OUT),
	.ARload(ARload),
	.BUS_AC(BUS_AC),
	.BUS_ALU(BUS_ALU),
	.BUS_DR(BUS_DR),
	.BUS_MEM(BUS_MEM),
	.BUS_PC(BUS_PC),
	.CPUclk(CPUclk),
	.DR_OUT(DR_OUT),
	.DRload(DRload),
	.IR_OUT(IR_OUT),
	.IRload(IRload),
	.MainBus(MainBus),
	.MDenable(MDenable),
	.MEM_OUT(MEM_OUT),
	.MemRead(MemRead),
	.MemWrite(MemWrite),
	.MuxOut(MuxOut),
	.PC_OUT(PC_OUT),
	.PCinc(PCinc),
	.PCload(PCload),
	.PCloadAR(PCloadAR),
	.PCloadZ(PCloadZ),
	.Zflag(Zflag),
	.Zload(Zload),
	.sampler_rx(sampler)
);
endmodule

