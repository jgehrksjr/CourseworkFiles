-- Quartus II generated Memory Initialization File (.mif)

WIDTH=8;
DEPTH=32;

ADDRESS_RADIX=BIN;
DATA_RADIX=BIN;

CONTENT BEGIN

00000 : 00010100; -- LOAD 20
00001 : 01010011; -- ADD 19
00010 : 00110101; -- STORE 21
00011 : 00011000; -- LOAD 24
00100 : 01110111; -- SUB 23
00101 : 00110110; -- STORE 22
00110 : 10001001; -- JUMP 9
00111 : 00011001; -- LOAD 25
01000 : 00111010; -- STORE 26
01001 : 00010110; -- LOAD 22
01010 : 01110110; -- SUB 22
01011 : 00111011; -- STORE 27
01100 : 10101111; -- conditional jump / JEQ 15 if opcode 101 is JEQ
01101 : 00010011; -- LOAD 19
01110 : 00110110; -- STORE 22
01111 : 00011100; -- LOAD 28
10000 : 00111101; -- STORE 29
10001 : 11100000; -- END / unimplemented opcode

10010 : 00000000;
10011 : 00001101; -- 13
10100 : 00001010; -- 10
10101 : 00000000; -- z
10110 : 00000000; -- k
10111 : 00000100; -- 4
11000 : 00010110; -- 22
11001 : 11001000; -- 200
11010 : 00000000; -- c
11011 : 00000000; -- d
11100 : 01100100; -- 100
11101 : 00000000;
11110 : 00000000;
11111 : 00000000;

END;