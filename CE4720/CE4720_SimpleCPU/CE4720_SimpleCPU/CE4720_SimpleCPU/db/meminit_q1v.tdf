--altmem_init CBX_DECLARE_ALL_CONNECTED_PORTS="OFF" DEVICE_FAMILY="Cyclone IV E" INIT_FILE="MainMem.MIF" INIT_TO_ZERO="NO" NUMWORDS=32 PORT_ROM_DATA_READY="PORT_CONNECTIVITY" ROM_READ_LATENCY=1 WIDTH=8 WIDTHAD=5 clock datain dataout init CARRY_CHAIN="MANUAL" CARRY_CHAIN_LENGTH=48 CYCLONEII_M4K_COMPATIBILITY="ON" LOW_POWER_MODE="AUTO"
