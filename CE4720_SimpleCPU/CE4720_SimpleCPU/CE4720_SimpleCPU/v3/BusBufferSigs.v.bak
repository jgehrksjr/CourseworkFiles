module reg8 (
   input clk,
   input [2:0] BusSrc,
   output reg BUS_NONE
   output reg BUS_PC
   output reg BUS_DR
   output reg BUS_AC 
   output reg BUS_MEM
   output reg BUS_ALU 
   output reg BUS_AR
);


localparam BUS_NONE = 3'b000;		// for bussSrc
localparam BUS_PC   = 3'b001;
localparam BUS_DR   = 3'b010;
localparam BUS_AC   = 3'b011;
localparam BUS_MEM  = 3'b100;
localparam BUS_ALU  = 3'b101;
localparam BUS_AR   = 3'b110;

always @(posedge clk) 
	begin  //high edge
		case (BusCrc)
		begin
			3'b000: //None
			begin
				BUS_NONE = 	1'b1;
				BUS_PC = 	1'b0;
				BUS_DR = 	1'b0;
				BUS_AC = 	1'b0;
				BUS_MEM = 	1'b0;
				BUS_ALU = 	1'b0;
				BUS_AR = 	1'b0;
         end
		
			3'b001: //PC Bus
			begin
				BUS_NONE = 	1'b0;
				BUS_PC = 	1'b1;
				BUS_DR = 	1'b0;
				BUS_AC = 	1'b0;
				BUS_MEM = 	1'b0;
				BUS_ALU = 	1'b0;
				BUS_AR = 	1'b0;
         end
			
			3'b010: //DR Bus
			begin
				BUS_NONE = 	1'b0;
				BUS_PC = 	1'b0;
				BUS_DR = 	1'b1;
				BUS_AC = 	1'b0;
				BUS_MEM = 	1'b0;
				BUS_ALU = 	1'b0;
				BUS_AR = 	1'b0;
         end
			
			3'b011: //AC BUS
			begin
				BUS_NONE = 	1'b0;
				BUS_PC = 	1'b0;
				BUS_DR = 	1'b0;
				BUS_AC = 	1'b1;
				BUS_MEM = 	1'b0;
				BUS_ALU = 	1'b0;
				BUS_AR = 	1'b0;
         end
			
			3'b100: //MEM Bus
			begin
				BUS_NONE = 	1'b0;
				BUS_PC = 	1'b0;
				BUS_DR = 	1'b0;
				BUS_AC = 	1'b0;
				BUS_MEM = 	1'b1;
				BUS_ALU = 	1'b0;
				BUS_AR = 	1'b0;
         end
			3'b100: //ALU Bus 
			begin
				BUS_NONE = 	1'b0;
				BUS_PC = 	1'b0;
				BUS_DR = 	1'b0;
				BUS_AC = 	1'b0;
				BUS_MEM = 	1'b0;
				BUS_ALU = 	1'b1;
				BUS_AR = 	1'b0;
         end
			
			3'b110: //AR BUS
			begin
				BUS_NONE = 	1'b0;
				BUS_PC = 	1'b0;
				BUS_DR = 	1'b0;
				BUS_AC = 	1'b0;
				BUS_MEM = 	1'b0;
				BUS_ALU = 	1'b0;
				BUS_AR = 	1'b1;
         end
			
			default: //all off
			begin
				BUS_NONE = 	1'b0;
				BUS_PC = 	1'b0;
				BUS_DR = 	1'b0;
				BUS_AC = 	1'b0;
				BUS_MEM = 	1'b0;
				BUS_ALU = 	1'b0;
				BUS_AR = 	1'b0;
         end
		endcase
   end
endmodule